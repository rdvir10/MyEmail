<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- IMAP and SMTP are plain sockets. Debug builds inherit this from the
         debug manifest; a release build without it cannot reach any server. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Android 13+ will not show a notification without this being granted at
         runtime. The Notifications screen asks for it when the switch is
         turned on, not on first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- WorkManager reschedules the background mail check after a reboot;
         without this the periodic pass silently stops until the app is
         opened again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- The five-minute and push sync modes. Android will not run work more
         often than every 15 minutes, nor hold a connection open, outside a
         foreground service, and a foreground service must show a permanent
         notification. Both modes are opt-in and say so before they are
         chosen; the periodic mode needs neither of these. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- The in-app updater. Lets MyEmail hand a downloaded APK to Android's
         package installer; Android still shows its own confirmation, and the
         user has to allow "Install unknown apps" for MyEmail once before it
         will even offer. Nothing is ever installed silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Suggesting recipients from the address book as you type. Asked for
         at runtime the first time a recipient field is used, and the app
         works without it: people you have already written to are suggested
         from your own mail either way. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!-- No Android backup, and no copying to a new phone. Left on, the whole
         mail cache (work mail included) went to the Google backup, and a
         restore brought back the secure-storage files without the Keystore
         key that unlocks them, so every account failed to connect and could
         not even be removed and added again. The app's own settings backup
         is the way to move to a new device. allowBackup covers Android 11
         and older; the extraction rules cover 12 and newer, where
         allowBackup alone still lets a device-to-device transfer through. -->
    <application
        android:label="MyEmail"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- No routes from outside. This activity is exported, and with
                 deep linking on, any app could start it on a route of its
                 choosing through the intent's data. The one route the app
                 uses, a second window's, comes only to WindowActivity. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Dropping the home-screen widget opens the app to ask which
                 mailbox it should count. The picker is written in Flutter
                 rather than as a second native screen, so it can show the
                 real folder tree with the accounts it belongs to. -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE"/>
            </intent-filter>
            <!-- Tapping the widget opens the app. -->
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.LAUNCH"/>
            </intent-filter>
            <!-- The share sheet. A photo, a PDF, a page's address or a piece
                 of text shared from any app becomes a new message here. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <!-- The way back from the browser after a Google sign-in. The
             scheme is the app's Google client ID reversed, which is the one
             form Google accepts for an Android client; it must match
             googleClientId in lib/data/auth/google_oauth_config.dart, and a
             test checks that it does. See OAuthRedirectActivity.kt. -->
        <activity
            android:name=".OAuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="com.googleusercontent.apps.not-configured"/>
            </intent-filter>
        </activity>

        <!-- A second window: the same app under another name, launched as
             a document with its own task affinity, so every start is a new
             task rather than a return to the one that is running. See
             WindowActivity.kt. Not exported: only the app opens these. -->
        <activity
            android:name=".WindowActivity"
            android:exported="false"
            android:launchMode="standard"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:taskAffinity="com.rdvir.mailtree.window"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
        </activity>

        <!-- The home-screen widget. It reads what the app and the background
             sync pass wrote; it never talks to a mail server itself. -->
        <receiver
            android:name=".MailboxCountWidgetProvider"
            android:label="@string/mailbox_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mailbox_count_widget_info"/>
        </receiver>
        <!-- Hands the downloaded APK to the installer as a content:// URI.
             A bare file:// URI to this app's private storage is unreadable by
             the installer and throws FileUriExposedException on anything
             modern. The authority must match the one MainActivity passes to
             FileProvider.getUriForFile. -->
        <!-- One provider, two authorities: the updater hands the installer a
             downloaded APK, and attachments are opened, shared, dragged and
             copied through the second name. They were two <provider>
             elements once, and that broke the updater on every phone: both
             were the same class, Android instantiates a provider once per
             class, and the second authority was served by an instance that
             only knew the first one's paths. The installer was handed a URL
             it could not open, and 2.10.0 could not update itself. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates;${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Links in messages open in the system browser or mail app.
             Android 11+ hides other apps unless they are declared here. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
    </queries>
</manifest>
