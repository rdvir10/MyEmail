<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="mailbox_widget_label">Mailbox counts</string>
    <string name="mailbox_widget_description">An icon for one mailbox, badged with how many messages arrived since you last looked and how many it holds.</string>
    <!-- Shown under the icon before a mailbox has been chosen, and if the one
         it was showing has since gone. -->
    <string name="mailbox_widget_unset">Tap to set up</string>
    <!-- The calendar widget. -->
    <string name="calendar_widget_label">Calendar</string>
    <string name="calendar_widget_description">Today\'s and tomorrow\'s meetings, from every account, with Join.</string>
    <string name="calendar_widget_today">Today</string>
    <string name="calendar_widget_tomorrow">Tomorrow</string>
    <string name="calendar_widget_join">Join</string>
    <string name="calendar_widget_all_day">All day</string>
    <!-- A meeting of a day or more, on the day it begins and the day it
         ends: "From 8:00 AM", "Until 8:30 AM". -->
    <string name="calendar_widget_from">From %1$s</string>
    <string name="calendar_widget_until">Until %1$s</string>
    <string name="calendar_widget_declined">Declined</string>
    <string name="calendar_widget_nothing_more">Nothing more today</string>
    <string name="calendar_widget_nothing">Nothing today or tomorrow</string>
    <!-- The calendar as an app icon (calendar idea #87). Under the icon it
         says calendar_widget_label. -->
    <string name="calendar_day_widget_label">Calendar icon</string>
    <string name="calendar_day_widget_description">An icon with today\'s date, badged with how many meetings are still to come today. Tap it for the calendar.</string>
    <!-- What a screen reader says of the badge. -->
    <plurals name="calendar_day_widget_left">
        <item quantity="one">%d meeting still to come today</item>
        <item quantity="other">%d meetings still to come today</item>
    </plurals>
</resources>
