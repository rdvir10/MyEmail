<?xml version="1.0" encoding="utf-8"?>
<!-- Four cells by two to begin with, and any size after.

     updatePeriodMillis is Android's least, half an hour: the widget drops a
     meeting once it is over and says "Today" of today by itself, from what
     it was given, whether or not MyEmail has run since. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/calendar_widget"
    android:previewLayout="@layout/calendar_widget"
    android:description="@string/calendar_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
