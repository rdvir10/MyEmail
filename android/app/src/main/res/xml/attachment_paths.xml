<?xml version="1.0" encoding="utf-8"?>
<!-- What the attachments FileProvider is allowed to hand to other apps.

     The cache directory only, which is where a downloaded attachment and a
     file dropped or pasted into the app are written. Mail, accounts and the
     message database live elsewhere and are not reachable through this. -->
<paths>
    <cache-path name="attachments" path="attachments/" />
    <cache-path name="incoming" path="incoming/" />
</paths>
