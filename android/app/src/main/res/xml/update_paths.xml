<?xml version="1.0" encoding="utf-8"?>
<!-- What the FileProvider in AndroidManifest.xml is allowed to share.

     Exactly one directory: the app's own support directory, which is where
     apk_installer.dart writes the download. Nothing else about this app is
     exposed, and nothing outside it is reachable. -->
<paths>
    <files-path name="updates" path="." />
    <cache-path name="update-cache" path="." />
    <external-files-path name="updates-external" path="." />
</paths>
