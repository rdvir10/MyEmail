<?xml version="1.0" encoding="utf-8"?>
<!-- The same red circle Android puts on an app icon for unread things, so
     the widget reads as one of the icons around it rather than as a card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFE53935" />
    <corners android:radius="10dp" />
    <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
</shape>
