<?xml version="1.0" encoding="utf-8"?>
<!-- The back layer of the adaptive icon. It fills the whole 108dp canvas
     although only the middle 72dp is guaranteed to be shown: the launcher
     shifts this layer about as the icon is tilted, and a background that
     stopped at the safe zone would show its edges doing it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FFFF7A18" />
                <item android:offset="1" android:color="#FFC1420A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
