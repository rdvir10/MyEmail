<?xml version="1.0" encoding="utf-8"?>
<!-- Shaped like an app icon, because that is what it sits next to: the icon,
     a badge in the top corner for what is new, a badge in the bottom corner
     for what the mailbox holds, and the name underneath.

     Numbers only. This is a home screen, in front of whoever is holding the
     tablet, so no senders and no subjects. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mailbox_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="2dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <!-- Two layers rather than the app icon itself: the tile is tinted
             to the colour this widget was given, and the dart is drawn over
             it. A single bitmap would have one colour baked in. -->
        <ImageView
            android:id="@+id/mailbox_widget_tile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/mailbox_widget_tile"
            android:contentDescription="@string/mailbox_widget_label" />

        <ImageView
            android:id="@+id/mailbox_widget_glyph"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="@null" />

        <!-- What arrived since you last looked. Hidden at zero, the way a
             notification badge is: a nought in a red circle reads as an
             alert about nothing. -->
        <TextView
            android:id="@+id/mailbox_widget_new"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:minWidth="20dp"
            android:layout_gravity="top|end"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:background="@drawable/mailbox_widget_new_badge"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:text="" />

        <!-- Everything in the mailbox. Always shown, nought included: an
             empty folder is worth knowing, and this badge is a count rather
             than an alert. -->
        <TextView
            android:id="@+id/mailbox_widget_total"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:minWidth="17dp"
            android:layout_gravity="bottom|start"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="@drawable/mailbox_widget_total_badge"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            android:maxLines="1"
            android:text="" />
    </FrameLayout>

    <!-- White with a shadow, which is what a launcher draws its own labels
         with and the only thing that stays readable over any wallpaper. -->
    <TextView
        android:id="@+id/mailbox_widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="@string/mailbox_widget_unset" />
</LinearLayout>
