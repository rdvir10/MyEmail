<?xml version="1.0" encoding="utf-8"?>
<!-- One meeting: its account's colour down the side, its title, when and
     where, and Join where it is online. Tapped, the meeting in MyEmail. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/calendar_row_root"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/calendar_row_colour"
        android:layout_width="4dp"
        android:layout_height="30dp"
        android:src="@drawable/calendar_widget_bar"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/calendar_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/calendar_widget_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/calendar_row_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/calendar_widget_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/calendar_row_join"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/calendar_widget_join"
        android:text="@string/calendar_widget_join"
        android:textColor="@color/calendar_widget_accent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
